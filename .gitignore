# Planning notes. These are working documents, not part of the shipped artifact.
# Anchored, so a nested directory named files/ is not swallowed by this rule.
/files/

# Build output. Anchored so that cmd/hollow/ is still tracked.
/hollow
/hollow.exe
/build/

# Release artifacts. Binaries belong on the release page, not in the history:
# committing them would put four megabytes into every clone for a file that is
# rebuilt byte for byte by make release.
/dist/
